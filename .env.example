DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Batch 1B-5): any postgres:// URL selects the pooled
# PostgreSQL driver; anything else (including file:) keeps local SQLite.
# Example: DATABASE_URL="postgresql://basera:CHANGE_ME@db.internal:5432/basera"
# Run `npm run db:migrate` once against a fresh database before starting.
# Optional pool tuning (postgres.js): PGHOST-style vars are NOT used — keep
# everything in DATABASE_URL. Defaults: max 10 connections per process.
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# AUTH_TRUST_HOST lets next-auth derive its origin from the incoming request
# (x-forwarded-host/host header) instead of a hardcoded NEXTAUTH_URL. Leave
# this on for local development so login/logout work on ANY dev port
# (3000, 3120/e2e, 3131/manual, LAN IPs) without intermittent 404/502
# redirects to a stale origin.
AUTH_TRUST_HOST=1
# Only set NEXTAUTH_URL when you need to PIN the auth origin, i.e. production
# behind a proxy that hides the real host:
#   NEXTAUTH_URL="https://www.basera.com"
# Leave it UNSET locally — a pinned localhost:3000 makes next-auth send
# login/logout redirects to that port even when the app runs elsewhere.
# NEXTAUTH_URL=""
# Canonical public origin used for verification links and password-reset
# links. Local dev: http://localhost:3000 (the dev port).
# Production: APP_URL="https://www.basera.com" (HTTPS, publicly reachable).
# Emails refuse to send in production unless this is a public HTTPS origin.
APP_URL="http://localhost:3000"
# Public origin used by SEO metadata: canonical URL, Open Graph / Twitter
# cards, robots.txt sitemap, and JSON-LD. Falls back to APP_URL when unset.
# Production: NEXT_PUBLIC_SITE_URL="https://www.basera.com"
NEXT_PUBLIC_SITE_URL=""
# Public workspace shown by the website chat widget. Leave as "urbannest"
# for the seeded demo organization, or override for your published workspace.
# Only a public workspace slug is sent; unknown slugs fail safely.
NEXT_PUBLIC_PUBLIC_ORG_SLUG="urbannest"
RESEND_API_KEY=""
# Canonical sender; RESEND_FROM is kept as a legacy alias for the same value.
# Production example (requires a verified domain, see below):
# EMAIL_FROM="Basera <no-reply@basera.com>"
EMAIL_FROM="Basera <onboarding@resend.dev>"
RESEND_FROM="Basera <onboarding@resend.dev>"

# Gmail SMTP for local development/testing (Batch: SMTP-first when fully set).
# SMTP_PASSWORD must be a Google App Password, not the normal Gmail password
# (Google Account → Security → 2-Step Verification → App passwords).
# When SMTP_HOST + SMTP_USER + SMTP_PASSWORD are all set, Basera sends via
# Gmail SMTP; otherwise it falls back to Resend. Never commit real values.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ANTHROPIC_API_KEY=""
# Preferred AI provider for Phase 4. When set, Basera uses OpenAI first and
# falls back to Anthropic. Keep keys server-side only — never NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# AI model for conversational brain (Gemini). Use fastest reliable model.
# GEMINI_CHAT_MODEL="gemini-1.5-flash"
# Fallback models for quota exhaustion (comma-separated).
# GEMINI_CHAT_FALLBACK_MODELS="gemini-1.5-flash-8b,gemini-1.5-flash,gemini-3.5-flash"
# AI turn timeout in milliseconds. Default 30000 (30s). Max 120000.
# AI_TURN_TIMEOUT_MS="30000"
CRON_SECRET="replace-with-a-long-random-string"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN="replace-with-a-long-random-string"
WHATSAPP_API_VERSION="v21.0"
# Optional but strongly recommended for validating Meta POST signatures.
WHATSAPP_APP_SECRET=""

# Distributed rate limiting (Batch 6) via Upstash Redis (HTTPS, no extra deps).
# LOCAL: leave both empty → in-memory per-process limiter (dev works as-is).
# PRODUCTION (multi-instance): set both + RATE_LIMIT_REQUIRE_REDIS=true.
#   UPSTASH_REDIS_REST_URL="https://...upstash.io"
#   UPSTASH_REDIS_REST_TOKEN=""
#   RATE_LIMIT_REQUIRE_REDIS="true"
# When distributed protection is active, a Redis outage FAILS CLOSED (429)
# on auth + public-chat limits instead of bypassing them. Never commit real
# credentials — set them in the host environment, not in a checked-in file.

# Production email setup:
# 1. Add your verified domain in Resend.
# 2. Add the DNS records Resend provides.
# 3. Verify the domain before sending from it.
# 4. Set RESEND_API_KEY to your real API key.
# 5. Set APP_URL/NEXTAUTH_URL to the public origin for reset links.

# Voice AI: browser voice sessions over the existing Basera AI pipeline.
# No telephony is implemented.
# MODES (never blurred, never auto-switched):
#   "mock"   = local text-passthrough stand-in for development and tests
#              (no audio, no vendor, no credentials needed).
#   "gemini" = low-cost live provider: Google STT + TTS relayed server-side
#              over the SAME turn pipeline. Requires GEMINI_API_KEY.
#   "openai" = production default / premium live provider: server-relayed
#              speech (Whisper STT + TTS) through the same turn pipeline.
#   "kokoro" = opt-in self-hosted TTS: reply synthesis via YOUR Kokoro
#              service; typed-transcript turns only (Kokoro is TTS-only).
# Any other value fails closed.
# NOTE: "mock" CANNOT transcribe microphone audio — it rejects audio by design.
# Use "gemini" (or "openai") whenever you click "Start voice".
VOICE_PROVIDER="gemini"
# Default turn language tag (en | hi | hinglish | es | fr | it | ja | zh | pt).
# Passed through as metadata; live providers validate against what their
# model actually supports and fail explicitly otherwise. Quality per language
# is not claimed without live testing.
VOICE_DEFAULT_LANGUAGE="en"
# Live OpenAI voice (ALL server-only — never NEXT_PUBLIC_, never committed
# with real values). Requires OPENAI_API_KEY (same key the AI pipeline
# already uses). Models/voice/timeout are optional tuning.
# VOICE_STT_MODEL="whisper-1"
# VOICE_TTS_MODEL="gpt-4o-mini-tts"
# VOICE_TTS_VOICE="alloy"
# VOICE_TURN_TIMEOUT_MS="60000"
# OPENAI_API_KEY is also required for embeddings-based knowledge retrieval
# in the voice pipeline. Without it, voice falls back to keyword retrieval.
# Live Gemini voice (server-only GEMINI_API_KEY; the browser only ever gets
# short-lived ephemeral Live tokens, never the key).
GEMINI_API_KEY=""
# STT model for server-side transcription of browser mic audio. Any
# transcription-capable Gemini model works; override to spread quota.
# GEMINI_STT_MODEL="gemini-flash-lite-latest"
# TTS model for reply speech. IMPORTANT: Gemini TTS models return EITHER a
# finished WAV (audio/wav) or raw 16-bit PCM (audio/L16) depending on the
# model — Basera normalises both, so either works.
# GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
# GEMINI_TTS_VOICE="Kore"
# Gemini's FREE TIER caps requests PER MODEL PER DAY (~10/day on the TTS
# models, ~20/day on the flash aliases) and answers capacity spikes with 503
# UNAVAILABLE. Basera therefore tries these same-vendor fallbacks in order, and
# only for quota/capacity errors (never for auth or bad-audio errors).
# Set either variable to "" to disable fallback and use the primary model only.
# GEMINI_STT_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.8-flash"
# GEMINI_TTS_FALLBACK_MODELS="gemini-3.1-flash-tts-preview,gemini-3.8-flash-tts"
# GEMINI_LIVE_MODEL="models/gemini-3.5-transcribe-live" (override only if
# Google retires the default; GEMINI_LIVE_ENABLED="false" forces fallback)
# GEMINI_TRANSCRIBE_LIVE_MODEL="models/gemini-3.5-transcribe-live" (override only if
# Google retires the default for Transcribe Live)
# Self-hosted Kokoro TTS (ALL server-only — never committed with real
# values). Basera calls YOUR service's OpenAI-compatible endpoint
# (e.g. Kokoro-FastAPI); nothing is sent to a hosted third party by default.
# KOKORO_BASE_URL="http://localhost:8880"
# KOKORO_MODEL="kokoro"
# KOKORO_VOICE="" (optional override; must be a known Kokoro voice ID,
#   otherwise the per-language default is used)
# KOKORO_API_KEY="" (optional; most self-hosted setups need no key)
